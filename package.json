{
  "name": "@abhay557/indian-fakedata",
  "version": "2.2.0",
  "description": "A generator for realistic Indian demographic data based on Census 2011 statistics.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "indian-fakedata": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:docs": "esbuild src/index.ts --bundle --minify --format=iife --global-name=IndianFakeData --platform=browser --alias:fs=./docs/stubs/fs.ts --alias:path=./docs/stubs/path.ts --outfile=docs/assets/lib.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx scripts/benchmark.ts",
    "demo": "tsx scripts/demo.ts",
    "download-census": "node scripts/download-census.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fake-data",
    "synthetic-data",
    "demographic",
    "census",
    "india",
    "abhay557",
    "mock-data",
    "testing",
    "ai-training",
    "data-generation",
    "population-simulator"
  ],
  "author": "Abhay Mourya",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "xlsx": "^0.18.5"
  }
}
